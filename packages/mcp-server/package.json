{
  "name": "@awesome-claude/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "awesome-claude-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:exe": "bun build src/server.ts --compile --outfile=dist/awesome-claude-mcp.exe --target=bun-windows-x64",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sql.js": "^1.11.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.0",
    "@awesome-claude/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "rimraf": "^5.0.0"
  }
}
